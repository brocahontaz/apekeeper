    "/api/diagnostics/sync-metrics": {
      "get": {
        "tags": [
          "Sync"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "x-required-roles": [
          "superadmin",
          "admin"
        ],
        "responses": {
          "200": {
            "description": "Aggregate sync metrics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer"
                  }
                }
              }
            }

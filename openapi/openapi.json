{
  "openapi": "3.0.3",
  "info": {
    "title": "ApeKeeper API",
    "version": "1.0.0",
    "description": "Authenticated guild roster and sync API. Sessions use HttpOnly cookies; state-changing requests also require X-CSRF-Token when CSRF is enabled."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Guild"
    },
    {
      "name": "Roster"
    },
    {
      "name": "Sync"
    },
    {
      "name": "Officer"
    }
  ],
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "apekeeper_session"
      },
      "csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "error"
        ],
        "properties": {
          "code": {
            "type": "string",
            "example": "invalid_request"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": "string",
            "description": "Legacy alias for message"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "battletag",
          "appRole"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "battletag": {
            "type": "string"
          },
          "appRole": {
            "type": "string",
            "enum": [
              "superadmin",
              "admin",
              "officer",
              "member"
            ]
          }
        }
      },
      "Character": {
        "type": "object",
        "required": [
          "id",
          "name",
          "realm",
          "classId",
          "className",
          "specId",
          "specName",
          "level",
          "itemLevel",
          "mythicRating",
          "bestKeyLevel",
          "stale"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "realm": {
            "type": "string"
          },
          "classId": {
            "type": "integer"
          },
          "className": {
            "type": "string"
          },
          "specId": {
            "type": "integer"
          },
          "specName": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "itemLevel": {
            "type": "number"
          },
          "mythicRating": {
            "type": "number"
          },
          "bestKeyLevel": {
            "type": "integer"
          },
          "syncedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "stale": {
            "type": "boolean"
          }
        }
      },
      "RosterPage": {
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "pageSize",
          "classes",
          "specs"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Character"
            }
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "specs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "required": [
          "rosterSize",
          "maxLevelMembers",
          "activeMembers",
          "classDistribution",
          "mythicPlus",
          "raidProgression",
          "staleCharacters",
          "notableChanges",
          "trends"
        ],
        "properties": {
          "rosterSize": {
            "type": "integer"
          },
          "maxLevelMembers": {
            "type": "integer"
          },
          "activeMembers": {
            "type": "integer"
          },
          "classDistribution": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "mythicPlus": {
            "type": "object"
          },
          "raidProgression": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "staleCharacters": {
            "type": "object"
          },
          "lastSync": {
            "type": "object",
            "nullable": true
          },
          "notableChanges": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "trends": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "History": {
        "type": "object",
        "required": [
          "from",
          "to",
          "retentionDays",
          "snapshots",
          "comparison"
        ],
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "retentionDays": {
            "type": "integer"
          },
          "snapshots": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "comparison": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "Progress": {
        "type": "object",
        "required": [
          "active",
          "runId",
          "status",
          "phase",
          "total",
          "updated",
          "failed",
          "startedAt",
          "dryRun"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "runId": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "updated": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "dryRun": {
            "type": "boolean"
          }
        }
      },
      "Guild": {
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "realm",
          "region",
          "role"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "realm": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          }
        }
      },
      "Run": {
        "type": "object",
        "required": [
          "id",
          "guildId",
          "startedAt",
          "finishedAt",
          "trigger",
          "status",
          "total",
          "updated",
          "failed",
          "errorSummary",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "guildId": {
            "type": "integer"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "trigger": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "notifyStatus": {
            "type": "string",
            "nullable": true
          },
          "total": {
            "type": "integer"
          },
          "updated": {
            "type": "integer"
          },
          "failed": {
            "type": "integer"
          },
          "errorSummary": {
            "type": "string"
          },
          "detail": {
            "type": "object"
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Stable error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Process and database health"
          },
          "503": {
            "description": "Degraded health"
          }
        }
      }
    },
    "/api/healthz": {
      "get": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Process and database health"
          },
          "503": {
            "description": "Degraded health"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Readiness"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/readyz": {
      "get": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Readiness"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/auth/login": {
      "get": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to OAuth provider"
          }
        }
      }
    },
    "/api/auth/callback": {
      "get": {
        "tags": [
          "Auth"
        ],
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect after login"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/guilds": {
      "get": {
        "tags": [
          "Guild"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Guild memberships",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Guild"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/guilds/select": {
      "post": {
        "tags": [
          "Guild"
        ],
        "security": [
          {
            "session": [],
            "csrf": []
          }
        ],
        "x-required-roles": [
          "any authenticated user"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "slug"
                ],
                "properties": {
                  "slug": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Selected guild",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "slug"
                  ],
                  "properties": {
                    "slug": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "tags": [
          "Roster"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "x-required-roles": [
          "member"
        ],
        "responses": {
          "200": {
            "description": "Guild dashboard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/roster": {
      "get": {
        "tags": [
          "Roster"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "x-required-roles": [
          "member"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "class",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "spec",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          },
          {
            "name": "rank",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "minLevel",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "minRating",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 0
            }
          },
          {
            "name": "stale",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "mythicSeason",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "season",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "raidTier",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "raid",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "raidDifficulty",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "minRaidProgress",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "raidProgress",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "activityAge",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3650
            }
          },
          {
            "name": "activityAgeDays",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3650
            }
          },
          {
            "name": "officerStatus",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "officerTag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "name",
                "level",
                "itemLevel",
                "mythicRating",
                "guildRank",
                "realm",
                "classSpec",
                "syncedAt"
              ]
            }
          },
          {
            "name": "direction",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ascending",
                "descending"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filtered roster",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RosterPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },

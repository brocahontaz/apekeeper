# Local PostgreSQL defaults. Docker Compose uses these to create the database.
POSTGRES_USER=apekeeper
POSTGRES_PASSWORD=apekeeper
POSTGRES_DB=apekeeper
# Used by native backend commands. Compose sets its own URL using the db service hostname.
DATABASE_URL=postgres://apekeeper:apekeeper@localhost:5432/apekeeper?sslmode=disable
SERVER_PORT=8080
# Optional native backend static-file fallback. The Compose backend image does not include frontend files.
STATIC_DIR=
LOG_LEVEL=info
# Required for Blizzard API and OAuth access.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_LOCALE=en_US
GUILD_NAME="Ape Enclosure"
# Required: Blizzard realm slug, for example area-52.
GUILD_REALM=
GUILD_REGION=us
SYNC_SCHEDULE=03:00
# Register this exact local callback route with Blizzard OAuth.
OAUTH_REDIRECT_URL=http://localhost:8080/api/auth/callback
# Used to sign session cookies; required for stable sessions across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=

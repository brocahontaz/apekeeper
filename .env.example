# Local development PostgreSQL defaults. Docker Compose uses these to create the database.
POSTGRES_USER=apekeeper
# Local development placeholder only; do not use this password outside local development.
POSTGRES_PASSWORD=apekeeper
POSTGRES_DB=apekeeper
# Required by native backend commands. Compose overrides this URL to use the db service hostname.
DATABASE_URL=postgres://apekeeper:apekeeper@localhost:5432/apekeeper?sslmode=disable
SERVER_PORT=8080
# Optional native backend static-file fallback. The Compose backend image does not include frontend files.
STATIC_DIR=
LOG_LEVEL=info
# Required: create an OAuth client in the Blizzard developer portal; never commit its credentials.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_LOCALE=en_US
GUILD_NAME="Ape Enclosure"
# Required: Blizzard realm slug, for example area-52.
GUILD_REALM=
GUILD_REGION=us
SYNC_SCHEDULE=03:00
# Required: register this exact callback URL with the Blizzard OAuth client: http://localhost:5173/api/auth/callback
# The browser authenticates on the frontend origin; the Vite dev server proxies /api to the backend,
# so the backend's post-login redirect to / lands on the SPA instead of the backend port.
OAUTH_REDIRECT_URL=http://localhost:5173/api/auth/callback
# Required: signs session cookies and must remain stable across restarts. Generate locally with: openssl rand -hex 32
SESSION_SECRET=
# Optional platform-level role: comma-separated BattleTags granted superadmin at sign-in; empty means nobody.
SUPER_ADMIN_BATTLETAGS=
